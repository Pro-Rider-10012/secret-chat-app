SECRET_KEY=change-this-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secret
SESSION_COOKIE_SECURE=false

MESSAGE_TTL_HOURS=24
OTP_TTL_MINUTES=10
EXPOSE_DEBUG_OTP=true
ENABLE_SCHEDULER=true
MAX_CHUNK_SIZE=5242880
STALE_UPLOAD_TTL_HOURS=6

UPLOAD_TMP_DIR=instance/uploads/tmp
LOCAL_MEDIA_DIR=instance/media

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
